[
  {
    "name": "disk",
    "title": "Disk",
    "command": "df -h / | tail -1 | awk '{print $3\" used of \"$2\" (\"$5\")\"}'"
  },
  {
    "name": "git",
    "title": "Git status",
    "command": "git -C /workspaces/utils status --short --branch"
  },
  {
    "name": "tmux",
    "title": "Tmux sessions",
    "command": "tmux ls 2>&1 || echo 'no server running'"
  },
  {
    "name": "pi",
    "title": "Pi versions",
    "command": "pi --version && pi-web --version"
  },
  {
    "name": "docker",
    "title": "Docker containers",
    "command": "docker ps --format '{{.Names}}\\t{{.Status}}' 2>&1 | head -20"
  }
]