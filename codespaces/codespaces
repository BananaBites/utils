#!/usr/bin/env python3
"""GitHub Codespaces usage of the authenticated user vs included quota.

Included usage resets at the start of each month (metered products bill per
calendar month). Token from $GITHUB_TOKEN or the repo .env: a fine-grained PAT
with the account permission "Plan" (read) — see .env.example.
Usage: codespaces        human-readable summary
       codespaces --json dashboard JSON (bars)
"""
import calendar
import json
import os
import re
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.request import Request, urlopen

# Included monthly quota per plan name: (core hours, GB-months of storage).
LIMITS = {"free": (120, 15), "pro": (180, 20)}


def read_token():
    tok = os.environ.get("GITHUB_TOKEN") or ""
    if not tok:
        env = Path(__file__).resolve().parent.parent / ".env"
        if env.exists():
            for line in env.read_text().splitlines():
                if line.startswith("GITHUB_TOKEN="):
                    tok = line.split("=", 1)[1].strip().strip('"')
    if not tok:
        sys.exit("codespaces: no token — cp .env.example .env and paste GITHUB_TOKEN (see .env.example)")
    return tok


TOKEN = read_token()


def api(path):
    req = Request("https://api.github.com" + path, headers={
        "Authorization": "Bearer " + TOKEN,
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "utils.d-codespaces",
    })
    with urlopen(req, timeout=30) as r:
        return json.load(r)


def usage(login, now):
    """(core hours, GB-months) used this month; try both billing endpoints."""
    month = f"year={now.year}&month={now.month}"
    month_hours = calendar.monthrange(now.year, now.month)[1] * 24
    errors = []
    for path in (f"/users/{login}/settings/billing/usage?{month}",
                 f"/users/{login}/settings/billing/usage/summary?{month}"):
        try:
            data = api(path)
        except Exception as e:
            errors.append(str(e))
            continue
        hours, gb = 0.0, 0.0
        for it in data.get("usageItems") or []:
            if "codespace" not in (it.get("product") or "").lower():
                continue
            unit = (it.get("unitType") or "").lower()
            qty = float(it.get("quantity") or it.get("grossQuantity") or 0)
            if "gigabyte" in unit or "gb" in unit or "storage" in unit:
                gb += qty / month_hours  # API reports GB-hours, quota is GB-months
            elif "hour" in unit:  # quantity is machine-hours; sku names the core count
                m = re.search(r"(\d+)[_-]?core", it.get("sku") or "") or re.search(r"_d(\d+)$", it.get("sku") or "")
                hours += qty if "core" in unit else qty * (int(m.group(1)) if m else 1)
        return hours, gb
    sys.exit("codespaces: usage unavailable: " + "; ".join(errors) + "\n"
             "  → needs a token with account permission Plan: read-only (see .env.example)")


def pct(used, inc):
    return f"{used / inc:.0%} of {inc:g}" if inc else "of ?"


now = datetime.now(timezone.utc)
user = api("/user")
login = user["login"]
plan = ((user.get("plan") or {}).get("name") or "").lower()
inc_h, inc_s = LIMITS.get(plan, (None, None))
hours, gb = usage(login, now)
reset = (now.replace(day=1) + timedelta(days=32)).replace(day=1)
days_left = (reset - now).days

if "--json" in sys.argv:
    print(json.dumps({
        "plan": plan or None,
        "windows": [{"label": label, "used_percent": round(100 * used / inc, 1) if inc else 0,
                     "detail": (f"{used:.4g} of {inc:g} {unit}" if inc else f"{used:.4g} {unit}"),
                     "resets_in": f"{days_left}d"}
                    for label, used, inc, unit in (("Core hours", hours, inc_h, "core-h"),
                                                   ("Storage", gb, inc_s, "GB-month"))],
    }))
    sys.exit()

print(f"Plan   {plan or '?'} ({login})")
print(f"Hours  {hours:g} core-h {pct(hours, inc_h)}")
print(f"Store  {gb:.3g} GB-month {pct(gb, inc_s)}")
print(f"Resets {reset:%b %-d} (in {days_left}d)")