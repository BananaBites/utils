#!/usr/bin/env bash
# Show local system usage: uptime, RAM, disk, load, updates, reboot.
# Usage: sysinfo        human-readable summary
#        sysinfo --json dashboard JSON (bars + notes)
set -euo pipefail

read -r ram_total ram_used ram_pct <<<"$(awk '/^MemTotal/ {t=$2} /^MemAvailable/ {a=$2} END {printf "%.0f %.0f %.0f", t*1024, (t-a)*1024, (t-a)/t*100}' /proc/meminfo)"
read -r disk_total disk_used disk_pct <<<"$(df -Pm / | awk 'NR==2 {gsub(/%/,"",$5); printf "%.0f %.0f %s", $2*1048576, $3*1048576, $5}')"
load=$(cut -d' ' -f1-3 /proc/loadavg)
updates=$(apt list --upgradable 2>/dev/null | awk '/\// {n++} END {print n+0}')
reboot="not required"
[[ -f /var/run/reboot-required ]] && reboot=required
fmt() { numfmt --to=iec --format=%.1f "$1"; }
uptime_txt=$(uptime -p | sed 's/^up //')

if [[ ${1:-} == --json ]]; then
  printf '{"windows":[{"label":"RAM","used_percent":%s,"detail":"%s of %s"},{"label":"Disk","used_percent":%s,"detail":"%s of %s"}],"notes":"Load    %s\\nUptime  %s\\nUpdates %s available\\nReboot  %s"}\n' \
    "$ram_pct" "$(fmt "$ram_used")" "$(fmt "$ram_total")" \
    "$disk_pct" "$(fmt "$disk_used")" "$(fmt "$disk_total")" \
    "$load" "$uptime_txt" "$updates" "$reboot"
else
  printf 'RAM     %s used of %s (%s%%)\nDisk    %s used of %s (%s%%)\nLoad    %s\nUptime  %s\nUpdates %s available\nReboot  %s\n' \
    "$(fmt "$ram_used")" "$(fmt "$ram_total")" "$ram_pct" \
    "$(fmt "$disk_used")" "$(fmt "$disk_total")" "$disk_pct" "$load" "$uptime_txt" "$updates" "$reboot"
fi